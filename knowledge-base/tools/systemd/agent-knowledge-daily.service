[Unit]
Description=Agent knowledge base: daily quiet run (consolidate -> project proposals)
Documentation=file://%h/agent-knowledge/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=idle
# сводчик до 3 ч (KB_DAILY_K1_TIMEOUT) + предложения; state/weekly.lock общий с недельным — ждёт до 4 ч
TimeoutStartSec=8h
UMask=0077
# поправь пути под себя: корень базы (KB_ROOT), HOME пользователя и где лежат kb и claude
Environment=KB_ROOT=/opt/agent-knowledge
Environment=HOME=/home/agent
Environment=PATH=/home/agent/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=KB_HINT=0
Environment=KB_S2_CTX=trimmed_index
# отправки нет в коде (kb daily не импортирует доставку); статус каждого шага — state/runs.jsonl (cmd: daily)
ExecStart=/opt/agent-knowledge/tools/kb daily
