[Unit]
Description=Agent knowledge base: weekly pipeline (consolidate -> project proposals -> weekly review -> optional Telegram)
Documentation=file://%h/agent-knowledge/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=idle
# ожидание state/weekly.lock за ежедневным до 4 ч (KB_WEEKLY_LOCK_WAIT) + сводчик до 4 ч (KB_WEEKLY_K1_TIMEOUT;
# в субботу обычно не нужен: kb daily уже свёл сырьё) + предложения и обзор
TimeoutStartSec=10h
UMask=0077
# поправь пути под себя: корень базы (KB_ROOT), HOME пользователя и где лежат kb и claude
Environment=KB_ROOT=/opt/agent-knowledge
Environment=HOME=/home/agent
Environment=PATH=/home/agent/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=KB_HINT=0
Environment=KB_S2_CTX=trimmed_index
# падение шага не роняет конвейер: обзор пишется по тому, что есть; статус каждого шага — state/runs.jsonl (cmd: weekly)
ExecStart=/opt/agent-knowledge/tools/kb weekly
